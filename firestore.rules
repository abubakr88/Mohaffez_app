rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // HELPER FUNCTIONS
    // ============================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function onlyUpdating(allowedFields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedFields);
    }

    function isAdmin() {
      // WHY: Prefer custom claim to avoid Firestore reads during rule evaluation.
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isSuspended() {
      // WHY: Block sensitive create flows when caller has an active suspension doc.
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/userSuspensions/$(request.auth.uid));
    }

    // ============================================
    // USER PROFILES & SETTINGS
    // ============================================

    match /users/{userId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() &&
                    request.auth.uid == userId &&
                    request.resource.data.uid == userId;

      allow update: if isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['followerCount', 'followingCount', 'fcmToken',
                    'fcmTokenUpdatedAt', 'photoUrl', 'bio',
                    'phoneNumber', 'addressText', 'addressLat',
                    'addressLng', 'specialization', 'name',
                    'privacySettings', 'updatedAt']);

      allow delete: if isOwner(userId);

      // Credentials
      match /credentials/{credentialId} {
        allow read: if isAdmin() || (isAuthenticated() && (
          resource == null ||
          resource.data.status == 'approved' ||
          request.auth.uid == userId
        ));

        allow create: if isOwner(userId) &&
                      request.resource.data.userId == userId &&
                      request.resource.data.status == 'pending';

        allow update: if isOwner(userId) ||
                      (isAdmin() && onlyUpdating(['status', 'reviewedBy', 'reviewedAt', 'rejectionReason']));

        allow delete: if isOwner(userId);
      }

      // Availability schedules
      match /availability/{availabilityId} {
        allow read: if isAuthenticated();

        allow create: if isOwner(userId) &&
                      request.resource.data.dayOfWeek is int &&
                      request.resource.data.dayOfWeek >= 1 &&
                      request.resource.data.dayOfWeek <= 7;

        allow update: if isOwner(userId)   // existing: mohaffez updates own availability
                      ||
                      // NEW: student restoring a slot when cancelling their request
                      (isAuthenticated() &&
                      onlyUpdating(['timeSlots', 'updatedAt']));
        allow delete: if isOwner(userId);
      }

      // Unavailable dates
      match /unavailableDates/{dateId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }

      // Privacy settings
      match /settings/{settingId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      // Pricing plans
      match /pricingPlans/{planId} {
        allow read: if isAuthenticated();

        allow create: if isOwner(userId) &&
                      request.resource.data.mohaffezId == userId &&
                      request.resource.data.isActive == true &&
                      request.resource.data.priceEGP > 0 &&
                      request.resource.data.sessionsCount > 0;

        allow update: if isOwner(userId) &&
                      request.resource.data.mohaffezId == userId;

        allow delete: if isOwner(userId);
      }
    }

    // ============================================
    // COLLECTION GROUP: credentials
    // ============================================

    match /{path=**}/credentials/{credentialId} {
      allow read: if isAdmin() || (isAuthenticated() && (
        resource == null ||
        resource.data.status == 'approved' ||
        request.auth.uid == resource.data.userId
      ));
    }

    // ============================================
    // SESSION REQUESTS (Booking Flow)
    // ============================================

    match /sessionRequests/{requestId} {
      allow read: if isAuthenticated() &&
                   (resource == null ||
                    request.auth.uid == resource.data.studentId ||
                    request.auth.uid == resource.data.mohaffezId);

      allow create: if isAuthenticated() &&
                     !isSuspended() &&
                     request.auth.uid == request.resource.data.studentId;

      // ─── Mohaffez-only transitions ───────────────────────────────────────

      allow update: if isAuthenticated() &&
                    request.auth.uid == resource.data.mohaffezId &&
                    (
                      // pending → awaitingpayment
                      // FIX: Added 'paymentAmount' (Bug 5 — sessionPrice written by acceptRequest)
                      //      Added 'sessionId'     (hafizSession pre-created in same batch)
                      (request.resource.data.status == 'awaitingpayment' &&
                       resource.data.status == 'pending' &&
                       onlyUpdating([
                         'status', 'acceptedAt', 'paymentDeadline',
                         'reminderSent', 'paymentAmount', 'sessionId',
                         'updatedAt'
                       ]))

                      ||

                      // pending | awaitingpayment → accepted (free / subscription, client-side)
                      // Cloud Functions (Admin SDK) bypass this rule; kept for edge-case
                      // direct acceptance flows.
                      (request.resource.data.status == 'accepted' &&
                       resource.data.status in ['pending', 'awaitingpayment'] &&
                       onlyUpdating([
                         'status', 'acceptedAt', 'updatedAt', 'sessionId', 'notificationsAlreadySent'
                       ]))

                      ||

                      // pending | awaitingpayment → rejected
                      (request.resource.data.status == 'rejected' &&
                       resource.data.status in ['pending', 'awaitingpayment'] &&
                       onlyUpdating([
                         'status', 'rejectedAt', 'rejectionReason', 'updatedAt'
                       ]))

                      ||

                      // Any status → cancelled (mohaffez-initiated)
                      (request.resource.data.status == 'cancelled' &&
                       onlyUpdating([
                         'status', 'cancelledAt', 'cancelledBy',
                         'cancellationReason', 'updatedAt'
                       ]))
                    );

      // ─── Student cancel rule ─────────────────────────────────────────────

      allow update: if isAuthenticated() &&
                    request.auth.uid == resource.data.studentId &&
                    request.resource.data.status == 'cancelled' &&
                    resource.data.status in [
                      'pending',
                      'awaitingpayment',
                      'awaitingdirectpaymentconfirmation'
                    ] &&
                    onlyUpdating([
                      'status', 'cancelledAt', 'cancelledBy',
                      'cancellationReason', 'updatedAt'
                    ]);

      // FIX: Added 'expired' to allow students to dismiss expired requests
      //      from their UI (cosmetic clean-up, not a state-machine transition).
      allow delete: if isAuthenticated() &&
                     request.auth.uid == resource.data.studentId &&
                     resource.data.status in [
                       'pending', 'awaitingpayment', 'rejected', 'expired'
                     ];
    }

    // ============================================
    // HAFIZ SESSIONS
    // ============================================

    match /hafizSessions/{sessionId} {
      allow read: if isAdmin() || (isAuthenticated() && (
        resource == null ||
        request.auth.uid == resource.data.studentId ||
        request.auth.uid == resource.data.mohaffezId
      ));

      allow create: if isAuthenticated() &&
        !isSuspended() &&
        (
          // Mohaffez pre-creates the session atomically with the accept
          (request.auth.uid == request.resource.data.mohaffezId &&
           request.resource.data.mohaffezId is string &&
           request.resource.data.studentId is string)
          ||
          // Student-side creation after verified payment
          (request.auth.uid == request.resource.data.studentId &&
           request.resource.data.requestId is string &&
           request.resource.data.status == 'accepted' &&
           request.resource.data.isPaid == true &&
           exists(/databases/$(database)/documents/sessionRequests/$(request.resource.data.requestId)) &&
           get(/databases/$(database)/documents/sessionRequests/$(request.resource.data.requestId)).data.studentId == request.auth.uid &&
           get(/databases/$(database)/documents/sessionRequests/$(request.resource.data.requestId)).data.mohaffezId == request.resource.data.mohaffezId &&
           get(/databases/$(database)/documents/sessionRequests/$(request.resource.data.requestId)).data.status == 'accepted' &&
           get(/databases/$(database)/documents/sessionRequests/$(request.resource.data.requestId)).data.isPaid == true)
        );

      allow update: if isAuthenticated() && (
        // Mohaffez can update any field on their own sessions
        (request.auth.uid == resource.data.mohaffezId)
        ||
        // Student can only update their own feedback fields
        (request.auth.uid == resource.data.studentId &&
         onlyUpdating(['studentFeedback', 'studentNotes', 'studentRating', 'updatedAt']))
        ||
        // NOTE: reminder flags are written by Cloud Functions (Admin SDK) which
        // bypass rules entirely. This catch-all rule exists only for any future
        // server-token-authenticated path. Consider removing if unused.
        (isAuthenticated() &&
         onlyUpdating([
           'reminder24hSent', 'reminder24hSentAt',
           'reminder1hSent',  'reminder1hSentAt',
           'updatedAt'
         ]))
      );

      allow delete: if isAuthenticated() &&
        request.auth.uid == resource.data.mohaffezId &&
        resource.data.status == 'cancelled';
    }

    // ============================================
    // PAYMENTS & SUBSCRIPTIONS
    // ============================================

    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        request.auth.uid == resource.data.studentId ||
        request.auth.uid == resource.data.mohaffezId
      );

      allow create: if isAuthenticated() &&
                    !isSuspended() &&
                    request.auth.uid == request.resource.data.studentId &&
                    request.resource.data.status == 'pending' &&
                    request.resource.data.amount >= 0 &&
                    request.resource.data.studentId is string &&
                    request.resource.data.mohaffezId is string;

      allow update: if isAuthenticated() && (
        // Student updates gateway order ID while payment is in-flight
        (request.auth.uid == resource.data.studentId &&
         resource.data.status in ['pending', 'processing'] &&
         onlyUpdating(['updatedAt', 'gatewayOrderId']))
        ||
        // Mohaffez marks cash payment complete
        (request.auth.uid == resource.data.mohaffezId &&
         resource.data.method == 'cash' &&
         resource.data.status == 'pending' &&
         request.resource.data.status == 'completed' &&
         onlyUpdating(['status', 'completedAt', 'paidAt', 'updatedAt']))
        ||
        // Cloud Function / webhook gateway updates (Admin SDK bypasses, but
        // this covers any server-token-based update path)
        (onlyUpdating([
          'status', 'completedAt', 'updatedAt', 'paidAt',
          'gatewayTransactionId', 'transactionReference',
          'gatewayResponse', 'failureReason',
          'processingStartedAt', 'processedAt',
          'idempotencyKey', 'subscriptionId',
          'method', 'gateway', 'notes', 'sessionId'
        ]))
      );

      allow delete: if false;
    }

    match /subscriptions/{subscriptionId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        request.auth.uid == resource.data.studentId ||
        request.auth.uid == resource.data.mohaffezId
      );

      allow create: if isAuthenticated() &&
                    !isSuspended() &&
                    request.auth.uid == request.resource.data.studentId &&
                    request.resource.data.status == 'active' &&
                    request.resource.data.remainingSessions > 0 &&
                    request.resource.data.totalSessions > 0 &&
                    request.resource.data.studentId is string &&
                    request.resource.data.mohaffezId is string;

      allow update: if isAuthenticated() && (
        // Consume one session
        (request.resource.data.remainingSessions == resource.data.remainingSessions - 1 &&
         resource.data.remainingSessions > 0 &&
         request.resource.data.status in ['active', 'expired', 'depleted'] &&
         onlyUpdating(['remainingSessions', 'lastUsedAt', 'status', 'updatedAt']))
        ||
        // Student cancels subscription
        (request.auth.uid == resource.data.studentId &&
         resource.data.status == 'active' &&
         request.resource.data.status == 'cancelled' &&
         onlyUpdating(['status', 'cancelledAt', 'updatedAt']))
        ||
        // Subscription expiry (scheduler / Cloud Function)
        (resource.data.status == 'active' &&
         request.resource.data.status == 'expired' &&
         onlyUpdating(['status', 'expiredAt', 'updatedAt']))
      );

      allow delete: if false;
    }

    // ============================================
    // EVENT SOURCING & ANALYTICS
    // ============================================

    match /paymentEvents/{eventId} {
      allow read: if isAdmin() || (isAuthenticated() && (
        resource == null || request.auth.uid == resource.data.userId
      ));
      allow write: if false;
    }

    match /sessionEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /paymentAnalytics/{analyticsId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ============================================
    // SLOT LOCKING
    // ============================================

    match /slotLocks/{lockId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ============================================
    // PROMO CODES
    // ============================================

    match /promocodes/{promoCode} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAuthenticated() &&
                    onlyUpdating(['usedCount', 'updatedAt', 'lastUsedAt', 'lastUsedBy']);
      allow delete: if isAdmin();
    }

    match /promoCodes/{promoCode} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAuthenticated() &&
                    onlyUpdating(['usedCount', 'updatedAt', 'lastUsedAt', 'lastUsedBy']);
      allow delete: if isAdmin();
    }

    // ============================================
    // DIRECT PAYMENT
    // ============================================

    match /directPaymentRequests/{id} {
      allow read: if isAuthenticated() && (
        resource == null ||
        request.auth.uid == resource.data.studentId ||
        request.auth.uid == resource.data.mohaffezId
      );
      allow write: if false;  // All writes via Cloud Functions (Admin SDK)
    }

    match /weeklyCommissionSummaries/{id} {
      allow read: if isAdmin() || (isAuthenticated() && (
        resource == null || request.auth.uid == resource.data.mohaffezId
      ));
      allow write: if false;
    }

    match /commissions/{id} {
      allow read: if isAdmin() || (isAuthenticated() && (
        resource == null || request.auth.uid == resource.data.mohaffezId
      ));
      allow write: if false;
    }

    // ============================================
    // SOCIAL FEATURES
    // ============================================

    match /follows/{followId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                    !isSuspended() &&
                    request.auth.uid == request.resource.data.studentId &&
                    request.resource.data.studentId is string &&
                    request.resource.data.mohaffezId is string &&
                    request.resource.data.studentId != request.resource.data.mohaffezId;
      allow delete: if isAuthenticated() &&
                    request.auth.uid == resource.data.studentId;
      allow update: if false;
    }

    match /reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                    !isSuspended() &&
                    request.auth.uid == request.resource.data.studentId &&
                    request.resource.data.rating >= 1 &&
                    request.resource.data.rating <= 5 &&
                    request.resource.data.studentId is string &&
                    request.resource.data.mohaffezId is string;
      allow update: if isAuthenticated() &&
                    request.auth.uid == resource.data.studentId &&
                    onlyUpdating(['rating', 'comment', 'updatedAt']);
      allow delete: if isAuthenticated() &&
                    request.auth.uid == resource.data.studentId;
    }

    // ============================================
    // NOTIFICATIONS
    // ============================================

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() &&
                  (resource == null ||
                   request.auth.uid == resource.data.userId ||
                   request.auth.uid == resource.data.recipientId);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
                    (request.auth.uid == resource.data.userId ||
                     request.auth.uid == resource.data.recipientId) &&
                    onlyUpdating(['isRead', 'readAt', 'updatedAt']);
      allow delete: if isAuthenticated() &&
                    (request.auth.uid == resource.data.userId ||
                     request.auth.uid == resource.data.recipientId);
    }

    // ============================================
    // ASSIGNMENTS & MISTAKES
    // ============================================

    match /assignments/{assignmentId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        request.auth.uid == resource.data.studentId ||
        request.auth.uid == resource.data.mohaffezId
      );
      allow create: if isAuthenticated() &&
                    request.auth.uid == request.resource.data.mohaffezId &&
                    request.resource.data.studentId is string;
      allow update: if isAuthenticated() && (
        (request.auth.uid == resource.data.mohaffezId)
        ||
        (request.auth.uid == resource.data.studentId &&
         onlyUpdating(['status', 'completedAt', 'studentNotes', 'updatedAt']))
      );
      allow delete: if isAuthenticated() &&
                    request.auth.uid == resource.data.mohaffezId;
    }

    match /quranMistakes/{mistakeId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        request.auth.uid == resource.data.studentId ||
        request.auth.uid == resource.data.mohaffezId
      );
      allow create: if isAuthenticated() &&
                    request.auth.uid == request.resource.data.mohaffezId;
      allow update: if isAuthenticated() &&
                    request.auth.uid == resource.data.mohaffezId;
      allow delete: if isAuthenticated() &&
                    request.auth.uid == resource.data.mohaffezId;
    }

    // ============================================
    // ADMIN & OPERATIONS
    // ============================================

    match /failedOperations/{operationId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();   // ← allow client retry logging
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /systemConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /userSuspensions/{suspensionId} {
      // WHY: Split write permissions by operation for explicit, predictable enforcement.
      allow read: if isAdmin() || isOwner(suspensionId);
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /broadcastHistory/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /devLogs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin() || isAuthenticated();
    }

    match /adminAuditLog/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /appVersions/{versionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================
    // CATCH-ALL
    // ============================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
