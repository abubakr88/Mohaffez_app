rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // HELPER FUNCTIONS
    // ============================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function onlyUpdating(allowedFields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedFields);
    }

    // Admin authority is granted exclusively via custom claims minted server-side
    // (Cloud Functions / Admin SDK). The previous Firestore-doc fallback is removed
    // so a self-set `role: 'admin'` field on /users/{uid} cannot grant admin powers.
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin'
      );
    }

    // Existing admin tokens that predate adminRole are treated as super admin
    // until their access is explicitly lowered by a super admin.
    function isSuperAdmin() {
      return isAdmin() && request.auth.token.adminRole != 'admin';
    }

    function hasAdminPermission(permission) {
      return isSuperAdmin() ||
             (
               isAdmin() &&
               request.auth.token.adminPermissions is map &&
               request.auth.token.adminPermissions[permission] == true
             );
    }

    function canManageUsers() {
      return hasAdminPermission('manageUsers');
    }

    function canReviewTeachers() {
      return hasAdminPermission('reviewTeachers');
    }

    function canManageFinance() {
      return hasAdminPermission('manageFinance');
    }

    function canSendBroadcasts() {
      return hasAdminPermission('sendBroadcasts');
    }

    function canRunMaintenance() {
      return hasAdminPermission('runMaintenance');
    }

    function isSuspended() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/userSuspensions/$(request.auth.uid));
    }

    // ============================================
    // USER PROFILES & SETTINGS
    // ============================================

    match /users/{userId} {
      allow read: if isAuthenticated();

      // Self-create on first sign-in. Role and status are constrained to a
      // closed set so a user cannot self-assign 'admin' or pre-approve as
      // 'mohaffez' with status 'active'. Admin role is server-only via
      // custom claims (see isAdmin()).
      allow create: if isAuthenticated() &&
                    request.auth.uid == userId &&
                    request.resource.data.uid == userId &&
                    request.resource.data.role in ['student', 'mohaffez'] &&
                    request.resource.data.status in ['active', 'pending_approval'];

      // User self-update: profile fields + setup account fields
      allow update: if isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            // ── Original profile fields ──
            'followerCount', 'followingCount', 'fcmToken',
            'fcmTokenUpdatedAt', 'photoUrl', 'bio',
            'phoneNumber', 'addressText', 'addressLat',
            'addressLng', 'specialization', 'name',
            'youtubeVideoUrl', 'meetingLink',
            'walletNumbers',
            'privacySettings', 'updatedAt',
            // ── Setup account fields (one-time setup wizard) ──
            'setupCompleted', 'dateOfBirth', 'city',
            'examScore', 'examTakenAt',
            'examQuestionCount', 'examCorrectCount',
            'examPassed', 'examRetryCount', 'examNextRetryAt',
            'setupWizardSeen'
          ]);

      // Mohaffez submitting for admin approval (registration step 3)
      // Separated so that 'status' is tightly constrained to 'pending_approval' only —
      // prevents self-escalation (e.g. user can never set status to 'active' or 'admin').
      allow update: if isOwner(userId) &&
        resource.data.role == 'mohaffez' &&
        request.resource.data.status == 'pending_approval' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'bio', 'specialization', 'youtubeVideoUrl',
            'status', 'setupCompleted',
            'approvalSubmittedAt', 'updatedAt'
          ]);

      // Admin user-management writes are permission-scoped. Cloud Functions
      // still bypass rules via Admin SDK for privileged workflows.
      allow update: if canManageUsers() ||
                    canReviewTeachers() ||
                    hasAdminPermission('manageUserRoles');

      allow delete: if isOwner(userId);

      // ── Credentials subcollection ──
      match /credentials/{credentialId} {
        // get: allow owner to read their own (even non-existent docs), or approved docs for anyone
        allow get: if canReviewTeachers() || isOwner(userId) || (isAuthenticated() && resource.data.status == 'approved');
        // list: resource is null for query operations — allow authenticated users and rely on client query filter
        allow list: if canReviewTeachers() || isOwner(userId) || isAuthenticated();

        allow create: if isOwner(userId) &&
                      request.resource.data.userId == userId &&
                      request.resource.data.status == 'pending';

        allow update: if isOwner(userId) ||
                      (canReviewTeachers() && onlyUpdating(['status', 'reviewedBy', 'reviewedAt', 'rejectionReason']));

        allow delete: if isOwner(userId);
      }

      // ── Availability schedules ──
      match /availability/{availabilityId} {
        allow read: if isAuthenticated();

        allow create: if isOwner(userId) &&
                      request.resource.data.dayOfWeek is int &&
                      request.resource.data.dayOfWeek >= 1 &&
                      request.resource.data.dayOfWeek <= 7;

        allow update: if isOwner(userId)
                      ||
                      (isAuthenticated() &&
                      onlyUpdating(['timeSlots', 'updatedAt']));
        allow delete: if isOwner(userId);
      }

      // ── Unavailable dates ──
      match /unavailableDates/{dateId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }

      // ── Privacy settings ──
      match /settings/{settingId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      // ── Pricing plans ──
      match /pricingPlans/{planId} {
        allow read: if isAuthenticated();

        allow create: if isOwner(userId) &&
                      request.resource.data.mohaffezId == userId &&
                      request.resource.data.isActive == true &&
                      request.resource.data.priceEGP > 0 &&
                      request.resource.data.sessionsCount > 0;

        allow update: if isOwner(userId) &&
                      request.resource.data.mohaffezId == userId;

        allow delete: if isOwner(userId);
      }

      // ── Exam results (setup account — one-time skill evaluation) ──
      match /examResults/{resultId} {
        allow read: if isOwner(userId) || canReviewTeachers() || canManageUsers();
        allow create: if isOwner(userId);
        allow update: if false;
        allow delete: if false;
      }

      // ── Student challenge questions (teacher-managed per-student question bank) ──
      // Path: users/{mohaffezId}/studentChallenges/{studentId}/questions/{questionId}
      // Teacher (userId == mohaffezId) has full write access.
      // Student can read their own questions when a session is active.
      match /studentChallenges/{studentId}/questions/{questionId} {
        allow read: if isOwner(userId) || request.auth.uid == studentId;
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // ── Memorized surahs (teacher-marked per student) ──
      // Path: users/{studentId}/memorizedSurahs/{surahNumber}
      // Any authenticated user can read (student sees own badges, teacher sees progress).
      // Only a mohaffez (role == 'mohaffez') can write or delete.
      match /memorizedSurahs/{surahNumber} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'mohaffez';
        allow delete: if isAuthenticated() &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'mohaffez';
      }
    }

    // ============================================
    // COLLECTION GROUP: credentials
    // ============================================

    match /{path=**}/credentials/{credentialId} {
      allow get: if canReviewTeachers() || (isAuthenticated() && (resource.data.status == 'approved' || request.auth.uid == resource.data.userId));
      // list: resource is null for query operations — allow authenticated users and rely on client query filter
      allow list: if canReviewTeachers() || isAuthenticated();
    }

    // ============================================
    // EXAM QUESTION BANK (Setup Account Feature)
    // ============================================

    match /examQuestions/{questionId} {
      // Any authenticated user can read (needed during setup wizard)
      allow read: if isAuthenticated();
      // Only admin can manage questions
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ============================================
    // SESSION REQUESTS (Booking Flow)
    // ============================================

    match /sessionRequests/{requestId} {
      allow read: if isAuthenticated() &&
                   (resource == null ||
                    request.auth.uid == resource.data.studentId ||
                    request.auth.uid == resource.data.mohaffezId);

      allow create: if isAuthenticated() &&
                     !isSuspended() &&
                     request.auth.uid == request.resource.data.studentId;

      // ─── Mohaffez-only transitions ───
      allow update: if isAuthenticated() &&
                    request.auth.uid == resource.data.mohaffezId &&
                    (
                      // pending → awaitingpayment
                      (request.resource.data.status == 'awaitingpayment' &&
                       resource.data.status == 'pending' &&
                       onlyUpdating([
                         'status', 'acceptedAt', 'paymentDeadline',
                         'reminderSent', 'paymentAmount', 'sessionId',
                         'updatedAt'
                       ]))

                      ||

                      // pending | awaitingpayment → accepted
                      (request.resource.data.status == 'accepted' &&
                       resource.data.status in ['pending', 'awaitingpayment'] &&
                       onlyUpdating([
                         'status', 'acceptedAt', 'updatedAt', 'sessionId', 'notificationsAlreadySent'
                       ]))

                      ||

                      // pending | awaitingpayment → rejected
                      (request.resource.data.status == 'rejected' &&
                       resource.data.status in ['pending', 'awaitingpayment'] &&
                       onlyUpdating([
                         'status', 'rejectedAt', 'rejectionReason', 'updatedAt'
                       ]))

                      ||

                      // Any status → cancelled (mohaffez-initiated)
                      (request.resource.data.status == 'cancelled' &&
                       onlyUpdating([
                         'status', 'cancelledAt', 'cancelledBy',
                         'cancellationReason', 'updatedAt'
                       ]))
                    );

      // ─── Student cancel rule ───
      // `accepted` is included so a student can cancel an already-confirmed
      // booking; the parallel hafizSessions update is gated by its own rule.
      allow update: if isAuthenticated() &&
                    request.auth.uid == resource.data.studentId &&
                    request.resource.data.status == 'cancelled' &&
                    resource.data.status in [
                      'pending',
                      'awaitingpayment',
                      'awaitingdirectpaymentconfirmation',
                      'accepted'
                    ] &&
                    onlyUpdating([
                      'status', 'cancelledAt', 'cancelledBy',
                      'cancellationReason', 'updatedAt'
                    ]);

      allow delete: if isAuthenticated() &&
                     request.auth.uid == resource.data.studentId &&
                     resource.data.status in [
                       'pending', 'awaitingpayment', 'rejected', 'expired'
                     ];
    }

    // ============================================
    // HAFIZ SESSIONS
    // ============================================

    match /hafizSessions/{sessionId} {
      allow read: if (canManageUsers() || canManageFinance()) || (isAuthenticated() && (
        resource == null ||
        request.auth.uid == resource.data.studentId ||
        request.auth.uid == resource.data.mohaffezId
      ));

      allow create: if isAuthenticated() &&
        !isSuspended() &&
        (
          (request.auth.uid == request.resource.data.mohaffezId &&
           request.resource.data.mohaffezId is string &&
           request.resource.data.studentId is string)
          ||
          (request.auth.uid == request.resource.data.studentId &&
           request.resource.data.requestId is string &&
           request.resource.data.status == 'accepted' &&
           request.resource.data.isPaid == true &&
           exists(/databases/$(database)/documents/sessionRequests/$(request.resource.data.requestId)) &&
           get(/databases/$(database)/documents/sessionRequests/$(request.resource.data.requestId)).data.studentId == request.auth.uid &&
           get(/databases/$(database)/documents/sessionRequests/$(request.resource.data.requestId)).data.mohaffezId == request.resource.data.mohaffezId &&
           get(/databases/$(database)/documents/sessionRequests/$(request.resource.data.requestId)).data.status == 'accepted' &&
           get(/databases/$(database)/documents/sessionRequests/$(request.resource.data.requestId)).data.isPaid == true)
        );

      allow update: if isAuthenticated() && (
        // Mohaffez starting their online session — can write meeting URL + start timestamps
        (request.auth.uid == resource.data.mohaffezId &&
         onlyUpdating(['meeting', 'meetingStartedAt', 'meetingTeacherJoinedAt', 'updatedAt']))
        ||
        // Mohaffez can update session fields but never the meeting map (written by Cloud Function only)
        (request.auth.uid == resource.data.mohaffezId &&
         !request.resource.data.diff(resource.data).affectedKeys()
           .hasAny(['meeting', 'meetingReminderSent', 'meetingReminderSentAt']))
        ||
        (request.auth.uid == resource.data.studentId &&
         onlyUpdating(['studentFeedback', 'teacherRating', 'reviewNotes', 'startedLate', 'meetingStudentJoinedAt', 'updatedAt']))
        ||
        // Student cancels their own session. Only from 'accepted' (no
        // re-cancelling, no cancelling completed sessions); status must
        // transition to 'cancelled' and cancelledBy must be 'student'.
        (request.auth.uid == resource.data.studentId &&
         resource.data.status == 'accepted' &&
         request.resource.data.status == 'cancelled' &&
         request.resource.data.cancelledBy == 'student' &&
         onlyUpdating(['status', 'cancelledBy', 'cancelledAt', 'updatedAt']))
        ||
        (isAuthenticated() &&
         onlyUpdating([
           'reminder24hSent', 'reminder24hSentAt',
           'reminder1hSent',  'reminder1hSentAt',
           'updatedAt'
         ]))
      );

      allow delete: if isAuthenticated() &&
        request.auth.uid == resource.data.mohaffezId &&
        resource.data.status == 'cancelled';
    }

    // ============================================
    // PAYMENTS & SUBSCRIPTIONS
    // ============================================

    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        request.auth.uid == resource.data.studentId ||
        request.auth.uid == resource.data.mohaffezId
      );

      allow create: if isAuthenticated() &&
                    !isSuspended() &&
                    request.auth.uid == request.resource.data.studentId &&
                    request.resource.data.status == 'pending' &&
                    request.resource.data.amount >= 0 &&
                    request.resource.data.studentId is string &&
                    request.resource.data.mohaffezId is string;

      allow update: if isAuthenticated() && (
        // Student attaches gateway order ID before redirecting to payment page.
        (request.auth.uid == resource.data.studentId &&
         resource.data.status in ['pending', 'processing'] &&
         onlyUpdating(['updatedAt', 'gatewayOrderId']))
        ||
        // Teacher confirms a cash payment they received in person.
        (request.auth.uid == resource.data.mohaffezId &&
         resource.data.method == 'cash' &&
         resource.data.status == 'pending' &&
         request.resource.data.status == 'completed' &&
         onlyUpdating(['status', 'completedAt', 'paidAt', 'updatedAt']))
        // All other status/gateway field transitions (status, gatewayTransactionId,
        // gatewayResponse, failureReason, etc.) are server-only via Cloud Functions / Admin SDK.
      );

      allow delete: if false;
    }

    match /subscriptions/{subscriptionId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        request.auth.uid == resource.data.studentId ||
        request.auth.uid == resource.data.mohaffezId
      );

      allow create: if false; // Server-only via Cloud Functions after verified payment.

      allow update: if isAuthenticated() && (
        // Student explicitly cancels their own active subscription.
        (request.auth.uid == resource.data.studentId &&
         resource.data.status == 'active' &&
         request.resource.data.status == 'cancelled' &&
         onlyUpdating(['status', 'cancelledAt', 'updatedAt']))
        // remainingSessions decrement and status→expired/depleted transitions are
        // server-only via Cloud Functions / Admin SDK to enforce session-consumption proof.
      );

      allow delete: if false;
    }

    // ============================================
    // DIRECT PAYMENT
    // ============================================

    match /directPaymentRequests/{id} {
      allow read: if isAuthenticated() && (
        resource == null ||
        request.auth.uid == resource.data.studentId ||
        request.auth.uid == resource.data.mohaffezId
      );
      allow write: if false;  // All writes via Cloud Functions (Admin SDK)
    }

    // ============================================
    // COMMISSIONS
    // ============================================

    match /weeklyCommissionSummaries/{id} {
      allow read: if canManageFinance() || (isAuthenticated() && (
        resource == null || request.auth.uid == resource.data.mohaffezId
      ));
      allow write: if false;
    }

    match /commissions/{id} {
      allow read: if canManageFinance() || (isAuthenticated() && (
        resource == null || request.auth.uid == resource.data.mohaffezId
      ));
      allow write: if false;
    }

    // weeklyCommissions — legacy/alternate commission collection used by directPayment handler
    match /weeklyCommissions/{id} {
      allow read: if canManageFinance() || (isAuthenticated() && (
        resource == null || request.auth.uid == resource.data.mohaffezId
      ));
      allow write: if false;
    }

    // ============================================
    // EVENT SOURCING & ANALYTICS
    // ============================================

    match /paymentEvents/{eventId} {
      allow read: if canManageFinance() || (isAuthenticated() && (
        resource == null || request.auth.uid == resource.data.userId
      ));
      allow write: if false;
    }

    match /sessionEvents/{eventId} {
      allow read: if canManageFinance() || canRunMaintenance();
      allow write: if false;
    }

    match /paymentAnalytics/{analyticsId} {
      allow read: if canManageFinance();
      allow write: if false;
    }

    // ============================================
    // SLOT LOCKING
    // ============================================

    match /slotLocks/{lockId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() &&
                    !isSuspended() &&
                    request.resource.data.lockedBy == request.auth.uid &&
                    request.resource.data.mohaffezId is string &&
                    request.resource.data.expiresAt is timestamp;

      // Only the locker, the mohaffez holding the slot, or admin can
      // update/release a lock. Prevents other authenticated users from
      // overwriting or deleting foreign locks.
      allow update: if canRunMaintenance() ||
                    (isAuthenticated() &&
                     (resource.data.lockedBy == request.auth.uid ||
                      resource.data.mohaffezId == request.auth.uid));

      allow delete: if canRunMaintenance() ||
                    (isAuthenticated() &&
                     (resource.data.lockedBy == request.auth.uid ||
                      resource.data.mohaffezId == request.auth.uid));
    }

    // ============================================
    // PROMO CODES (both casing variants)
    // ============================================

    match /promocodes/{promoCode} {
      allow read: if isAuthenticated();
      allow create: if canManageFinance();
      allow update: if isAuthenticated() &&
                    (canManageFinance() ||
                     onlyUpdating(['usedCount', 'updatedAt', 'lastUsedAt', 'lastUsedBy']));
      allow delete: if canManageFinance();
    }

    match /promoCodes/{promoCode} {
      allow read: if isAuthenticated();
      allow create: if canManageFinance();
      allow update: if isAuthenticated() &&
                    (canManageFinance() ||
                     onlyUpdating(['usedCount', 'updatedAt', 'lastUsedAt', 'lastUsedBy']));
      allow delete: if canManageFinance();
    }

    // ============================================
    // SOCIAL FEATURES
    // ============================================

    match /follows/{followId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                    !isSuspended() &&
                    request.auth.uid == request.resource.data.studentId &&
                    request.resource.data.studentId is string &&
                    request.resource.data.mohaffezId is string &&
                    request.resource.data.studentId != request.resource.data.mohaffezId;
      allow delete: if isAuthenticated() &&
                    request.auth.uid == resource.data.studentId;
      allow update: if false;
    }

    match /reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                    !isSuspended() &&
                    request.auth.uid == request.resource.data.studentId &&
                    request.resource.data.rating >= 1 &&
                    request.resource.data.rating <= 5 &&
                    request.resource.data.studentId is string &&
                    request.resource.data.mohaffezId is string;
      allow update: if isAuthenticated() &&
                    request.auth.uid == resource.data.studentId &&
                    onlyUpdating(['rating', 'comment', 'updatedAt']);
      allow delete: if isAuthenticated() &&
                    request.auth.uid == resource.data.studentId;
    }

    // ============================================
    // NOTIFICATIONS
    // ============================================

    match /notifications/{notificationId} {
      allow read: if canManageUsers() ||
                  (isAuthenticated() &&
                  (resource == null ||
                   request.auth.uid == resource.data.userId ||
                   request.auth.uid == resource.data.recipientId));

      // Clients may create notifications targeting another user (e.g. student
      // notifying mohaffez on booking). Tighten initial state to block garbage
      // writes and prevent pre-read spam: must target a valid user, must start
      // unread, and must use server time.
      allow create: if isAuthenticated() &&
                    !isSuspended() &&
                    request.resource.data.userId is string &&
                    request.resource.data.userId.size() > 0 &&
                    request.resource.data.isRead == false &&
                    request.resource.data.createdAt == request.time &&
                    request.resource.data.title is string &&
                    request.resource.data.body is string;

      allow update: if isAuthenticated() &&
                    (request.auth.uid == resource.data.userId ||
                     request.auth.uid == resource.data.recipientId) &&
                    onlyUpdating(['isRead', 'readAt', 'updatedAt']);
      allow delete: if isAuthenticated() &&
                    (request.auth.uid == resource.data.userId ||
                     request.auth.uid == resource.data.recipientId);
    }

    // ============================================
    // ASSIGNMENTS & MISTAKES
    // ============================================

    match /assignments/{assignmentId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        request.auth.uid == resource.data.studentId ||
        request.auth.uid == resource.data.mohaffezId
      );
      allow create: if isAuthenticated() &&
                    request.auth.uid == request.resource.data.mohaffezId &&
                    request.resource.data.studentId is string;
      allow update: if isAuthenticated() && (
        (request.auth.uid == resource.data.mohaffezId)
        ||
        (request.auth.uid == resource.data.studentId &&
         onlyUpdating(['status', 'completedAt', 'studentNotes', 'updatedAt']))
      );
      allow delete: if isAuthenticated() &&
                    request.auth.uid == resource.data.mohaffezId;
    }

    match /quranMistakes/{mistakeId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        request.auth.uid == resource.data.studentId ||
        request.auth.uid == resource.data.mohaffezId
      );
      allow create: if isAuthenticated() &&
                    request.auth.uid == request.resource.data.mohaffezId;
      allow update: if isAuthenticated() &&
                    request.auth.uid == resource.data.mohaffezId;
      allow delete: if isAuthenticated() &&
                    request.auth.uid == resource.data.mohaffezId;
    }

    // ============================================
    // ADMIN & OPERATIONS
    // ============================================

    match /failedOperations/{operationId} {
      allow read: if canRunMaintenance();

      // Clients enqueue retry records when a best-effort side-effect (e.g. a
      // post-booking notification) fails. Constrain initial state so the queue
      // can't be poisoned: must start as pending-retry at retryCount 0, with
      // server time and a non-empty operationType. Admin-only thereafter.
      allow create: if isAuthenticated() &&
                    request.resource.data.operationType is string &&
                    request.resource.data.operationType.size() > 0 &&
                    request.resource.data.status == 'pending-retry' &&
                    request.resource.data.retryCount == 0 &&
                    request.resource.data.timestamp == request.time;

      allow update: if canRunMaintenance();
      allow delete: if canRunMaintenance();
    }

    match /systemConfig/{configId} {
      allow read: if configId != 'adminMetrics' || isAdmin();
      allow write: if isSuperAdmin();
    }

    match /userSuspensions/{suspensionId} {
      allow read: if canManageUsers() || isOwner(suspensionId);
      allow create: if canManageUsers();
      allow update: if canManageUsers();
      allow delete: if canManageUsers();
    }

    match /broadcastHistory/{id} {
      allow read: if canSendBroadcasts();
      allow write: if canSendBroadcasts();
    }

    match /devLogs/{logId} {
      allow read: if canRunMaintenance();
      allow write: if canRunMaintenance();
    }

    match /adminAuditLog/{logId} {
      allow read: if isSuperAdmin();
      allow write: if false;  // Only Cloud Functions (Admin SDK) write audit logs
    }

    match /appVersions/{versionId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ============================================
    // WALLET SYSTEM
    // All mutations go through Cloud Functions (Admin SDK bypasses these
    // rules). Clients have read-only access to their own data + create-only
    // access to their own top-up request submissions.
    // ============================================

    match /wallets/{walletId} {
      // A user can read their own wallet. Admin can read any wallet.
      // System wallets (system_*) are admin-only.
      allow read: if canManageFinance() ||
                     (isAuthenticated() && walletId == request.auth.uid);
      allow write: if false; // server-only
    }

    match /walletTransactions/{txId} {
      // A user can read transactions on their own wallet. Admin reads all.
      allow read: if canManageFinance() ||
                     (isAuthenticated() && resource.data.walletId == request.auth.uid);
      allow write: if false; // server-only
    }

    match /walletTransactionGroups/{groupId} {
      // Group markers are an internal idempotency mechanism. Admin-only.
      allow read: if canManageFinance();
      allow write: if false; // server-only
    }

    match /topUpRequests/{requestId} {
      // User creates their own pending top-up request (with proof).
      // The Cloud Function verifies it. Listing own requests = read by owner.
      allow read: if canManageFinance() ||
                     (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.amountEgp is number &&
                       request.resource.data.amountEgp > 0;
      allow update, delete: if false; // server-only (verifyWalletTopUp)
    }

    match /payoutRequests/{requestId} {
      // Teacher reads their own. Admin reads all.
      allow read: if canManageFinance() ||
                     (isAuthenticated() && resource.data.mohaffezId == request.auth.uid);
      allow write: if false; // server-only (requestPayout / startPayout / completePayout / failPayout)
    }

    // ============================================
    // CATCH-ALL — Deny everything not explicitly matched
    // ============================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
