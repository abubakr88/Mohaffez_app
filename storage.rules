rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Profile photos: authenticated user can read/write their own photo only
    match /profile_photos/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == fileName.replace('.jpg', '')
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Teacher credentials: teachers upload their own certificate images, admins review.
    match /credentials/{userId}/{fileName} {
      // Approved certificate URLs are exposed only through authenticated
      // teacher profiles. The Firestore query controls which credentials are
      // public; Storage allows signed-in viewers to load their image assets.
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.size < 3 * 1024 * 1024
                            && request.resource.contentType.matches('image/(jpeg|png)');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
