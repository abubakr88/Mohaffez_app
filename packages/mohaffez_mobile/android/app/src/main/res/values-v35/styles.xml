<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15 enforces edge-to-edge for targetSdk 35. UCrop is a native
         third-party activity, so opt this screen out to keep its toolbar and
         crop handles below the status bar. -->
    <style name="MohaffezCropperTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">#095752</item>
        <item name="android:navigationBarColor">#111827</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
