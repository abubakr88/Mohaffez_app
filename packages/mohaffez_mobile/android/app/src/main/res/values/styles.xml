<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launch theme (light mode). AppCompat parent handles edge-to-edge correctly on API 35+. -->
    <style name="LaunchTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <!-- Applied once the Flutter engine is running. Flutter manages all insets from here. -->
    <style name="NormalTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
    <!-- Native image cropper screen. Keep it out of system bars so crop
         controls are reachable on Android devices with edge-to-edge UI. -->
    <style name="MohaffezCropperTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">#095752</item>
        <item name="android:navigationBarColor">#111827</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
